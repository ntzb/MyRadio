<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- "Glassy" dark grey: translucent so the wallpaper shows through, with a faint light edge.
         (Home-screen widgets can't do a real backdrop blur, so translucency is the glass effect.) -->
    <solid android:color="#CC26262B" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#40FFFFFF" />
</shape>
